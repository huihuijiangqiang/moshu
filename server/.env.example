# Database
DATABASE_URL=postgresql+asyncpg://moshu:moshu@localhost:5432/moshu
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Optional one-time first-admin setup token. Remove it after /auth/bootstrap succeeds.
# BOOTSTRAP_TOKEN=generate-a-long-random-value
# Dedicated key material for encrypting user-provided model credentials.
# Keep stable across restarts; changing it requires credential re-entry.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Model Gateway
MODEL_GATEWAY_CHEAP_URL=http://localhost:8001/v1
MODEL_GATEWAY_CHEAP_KEY=sk-xxx
MODEL_GATEWAY_MAIN_URL=http://localhost:8002/v1
MODEL_GATEWAY_MAIN_KEY=sk-xxx
MODEL_GATEWAY_PREMIUM_URL=http://localhost:8003/v1
MODEL_GATEWAY_PREMIUM_KEY=sk-xxx

# Dedicated embedding gateway (base URL or full /embeddings endpoint)
EMBEDDING_GATEWAY_URL=https://embedding-gateway.example/v1
EMBEDDING_GATEWAY_KEY=embedding-key-placeholder
EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_DIMENSIONS=2048

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_EXPORTS=moshu-exports
S3_BUCKET_UPLOADS=moshu-uploads

# App
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
BUILD_REVISION=local

# Mainland payment credentials (leave empty until merchant accounts are ready).
# Private keys/certificates must be mounted outside the repository.
PAYMENT_NOTIFY_BASE_URL=https://your-domain.example/api/billing/webhooks
PAYMENT_REQUEST_TIMEOUT=15
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
# Directory containing current WeChat Pay platform certificates (*.pem).
# Download/rotate them through the official certificate API; do not commit them.
WECHAT_PAY_PLATFORM_CERTIFICATES_DIR=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# Consistency Pipeline
CONSISTENCY_GATEWAY_TIER=main
CONSISTENCY_EXTRACTION_MODEL=gpt-4o-mini
CONSISTENCY_SUMMARY_MODEL=gpt-4o-mini
CONSISTENCY_CHUNK_CHARS=6000
CONSISTENCY_CHUNK_OVERLAP_CHARS=400
CONSISTENCY_MAX_CHUNKS=40

# SSE 流式与重试
CONSISTENCY_REASONING_EFFORT=low
CONSISTENCY_REQUEST_TIMEOUT=180.0
CONSISTENCY_MAX_RETRIES=3
CONSISTENCY_RETRY_BASE_DELAY=1.0

# Novel Generation (GENERATION_MODEL 留空时复用 CONSISTENCY_SUMMARY_MODEL)
GENERATION_GATEWAY_TIER=main
GENERATION_MODEL=
GENERATION_REASONING_EFFORT=low
GENERATION_REQUEST_TIMEOUT=600.0
GENERATION_CONTEXT_WINDOW_TOKENS=256000
GENERATION_MAX_OUTPUT_TOKENS=32000
GENERATION_CONTEXT_SAFETY_MARGIN_TOKENS=16000
