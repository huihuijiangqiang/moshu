{
  "name": "moshu-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:preview": "vue-tsc --noEmit && vite build --mode preview",
    "deploy:preview": "npm run build:preview && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.7",
    "@tiptap/extension-character-count": "^3.0.7",
    "@tiptap/extension-placeholder": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "@tiptap/suggestion": "^3.0.7",
    "@tiptap/vue-3": "^3.0.7",
    "idb-keyval": "^6.2.1",
    "pinia": "^2.2.6",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.14.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10",
    "wrangler": "4.130.0"
  }
}
