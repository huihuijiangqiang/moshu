# Copy this file outside the repository and fill every required value.
# The real file must not be committed or baked into an image.

POSTGRES_DB=moshu
POSTGRES_USER=moshu
# Keep this value URL-safe, or percent-encode it inside DATABASE_URL below.
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URL=postgresql+asyncpg://moshu:replace-with-a-long-random-password@postgres:5432/moshu
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-at-least-32-byte-random-secret
BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloudflare Turnstile. `adaptive` asks for a challenge after repeated failures;
# use `always` for high-risk public deployments. Keep secrets outside Git.
AUTH_CAPTCHA_MODE=adaptive
AUTH_CAPTCHA_SITE_KEY=replace-with-turnstile-site-key
AUTH_CAPTCHA_SECRET_KEY=replace-with-turnstile-secret-key
AUTH_CAPTCHA_CHALLENGE_TTL_SECONDS=300
AUTH_CAPTCHA_ADAPTIVE_THRESHOLD=3
AUTH_FAILURE_LIMIT=8
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_FAIL_CLOSED=true

# Supply external model and S3-compatible services; no provider keys belong in git.
MODEL_GATEWAY_CHEAP_URL=https://provider.example/v1
MODEL_GATEWAY_CHEAP_KEY=replace-me
MODEL_GATEWAY_MAIN_URL=https://provider.example/v1
MODEL_GATEWAY_MAIN_KEY=replace-me
MODEL_GATEWAY_PREMIUM_URL=https://provider.example/v1
MODEL_GATEWAY_PREMIUM_KEY=replace-me
# Optional dedicated image gateway; leave blank to use the main gateway.
IMAGE_GATEWAY_URL=
IMAGE_GATEWAY_KEY=
IMAGE_GATEWAY_MODEL=gpt-image-2
# Set a fixed per-image price after checking upstream cost. Zero disables generation.
IMAGE_GENERATION_CREDITS=0
EMBEDDING_GATEWAY_URL=https://provider.example/v1
EMBEDDING_GATEWAY_KEY=replace-me
EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_DIMENSIONS=2048

S3_ENDPOINT=https://s3.example
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET_EXPORTS=moshu-exports
S3_BUCKET_UPLOADS=moshu-uploads

DEBUG=false
# Use the public origin exposed by the Cloudflare Tunnel.
CORS_ORIGINS=https://your-domain.example
LOG_LEVEL=INFO
BUILD_REVISION=production
# Public HTTPS origin used in password-reset links and other user-facing URLs.
PUBLIC_APP_URL=https://your-domain.example

# The API refuses to start with the sample cryptographic values when either
# PUBLIC_APP_URL or CORS_ORIGINS is public. Generate both values independently
# before the first deployment, for example with `openssl rand -base64 48`.

GENERATION_GATEWAY_TIER=main
GENERATION_MODEL=
GENERATION_REVIEW_MODEL=
GENERATION_REASONING_EFFORT=low
GENERATION_REQUEST_TIMEOUT=600
GENERATION_CONTEXT_WINDOW_TOKENS=256000
GENERATION_MAX_OUTPUT_TOKENS=32000
GENERATION_CONTEXT_SAFETY_MARGIN_TOKENS=16000

CONSISTENCY_GATEWAY_TIER=main
CONSISTENCY_EXTRACTION_MODEL=gpt-4o-mini
CONSISTENCY_SUMMARY_MODEL=gpt-4o-mini
CONSISTENCY_CHUNK_CHARS=6000
CONSISTENCY_CHUNK_OVERLAP_CHARS=400
CONSISTENCY_MAX_CHUNKS=40
CONSISTENCY_REASONING_EFFORT=low
CONSISTENCY_REQUEST_TIMEOUT=180
CONSISTENCY_MAX_RETRIES=3
CONSISTENCY_RETRY_BASE_DELAY=1

# Leave payment fields empty until merchant credentials and certificates are mounted.
PAYMENT_NOTIFY_BASE_URL=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERTIFICATES_DIR=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_ALIPAY_PUBLIC_KEY_PATH=
